# ==============================================================================
# VEXIS SMART HOME - ENVIRONMENT TEMPLATE
# Copy this file to `.env` and replace all `CHANGE_ME_*` values before startup.
# ==============================================================================

# --- General ---
TZ=Europe/Rome
DOMAIN_SUFFIX=home

# --- Vexis Assistant Identity ---
VEXIS_WAKE_WORD=Vexis
VEXIS_STOP_WORD=Stop
VEXIS_LLM_MODEL=qwen2.5:7b
VEXIS_SESSION_TTL_SEC=60
VEXIS_MAX_HISTORY_TURNS=3

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=vexis_orchestrator
MQTT_PASSWORD=CHANGE_ME_STRONG_MQTT_PASSWORD

# --- Backend Orchestrator ---
BACKEND_PORT=3001
WS_PORT=3002
WS_AUTH_TOKEN=CHANGE_ME_HEX_TOKEN_FOR_ESP32_AND_KIOSK
LOG_LEVEL=info

# --- Ollama & Local AI ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_KEEP_ALIVE=-1
WHISPER_HOST=http://whisper:9000
PIPER_HOST=http://piper:10200

# --- Integrations (Least Privilege) ---
# Immich: create a Read-Only API key from Immich Web UI -> Account Settings
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=CHANGE_ME_IMMICH_READONLY_API_KEY

# Ntfy (Android Alarm / Notifications)
NTFY_URL=http://ntfy:80
NTFY_TOPIC=vexis_alarms_CHANGE_ME

# --- Homelab Storage Paths (Host Linux) ---
DATA_ROOT=/srv/vexis/data
MEDIA_ROOT=/mnt/storage/media
IMMICH_UPLOAD_LOCATION=/mnt/storage/immich

# --- Immich Database ---
IMMICH_DB_PASSWORD=CHANGE_ME_IMMICH_POSTGRES_PASSWORD
